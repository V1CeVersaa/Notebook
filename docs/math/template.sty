\RequirePackage[most]{tcolorbox}

\newcommand{\newtcbenvironment}[2]{
    \tcolorboxenvironment{#1}{#2, enhanced, breakable, sharp corners, leftrule=2pt, rightrule=0pt, toprule=0pt, bottomrule=0pt}
    \tcolorboxenvironment{#1*}{#2, enhanced, breakable, rounded corners, leftrule=2pt, rightrule=0pt, toprule=0pt, bottomrule=0pt}
}

\newtcbenvironment{theorem}{colframe=RoyalPurple, colback=RoyalPurple!8}
\newtcbenvironment{proposition}{colframe=RoyalPurple, colback=RoyalPurple!8}
\newtcbenvironment{corollary}{colframe=NavyBlue, colback=SkyBlue!8}
\newtcbenvironment{lemma}{colframe=NavyBlue, colback=SkyBlue!8}
\newtcbenvironment{claim}{colframe=NavyBlue, colback=SkyBlue!8}

\newtcbenvironment{definition}{colframe=ForestGreen, colback=ForestGreen!5}
\newtcbenvironment{example}{colframe=RawSienna, colback=RawSienna!5}
\newtcbenvironment{problem}{colframe=WildStrawberry!30, colback=WildStrawberry!5}

\newtcolorbox{cbox}[1][]{%
    enhanced,
    breakable,
    sharp corners,
    leftrule=2pt, rightrule=0pt, toprule=0pt, bottomrule=0pt,
    colframe=SkyBlue,
    colback=SkyBlue!8,
    fontupper=\itshape,
    #1
}

\newcommand{\subtitle}[1]{\gdef\notecoversubtitle{#1}}
\newcommand{\notecoversubtitle}{}
\newcommand{\lastupdated}[1]{\gdef\notecoverlastupdated{#1}}
\newcommand{\notecoverlastupdated}{\today}
\definecolor{NoteTOCRed}{RGB}{220,40,70}

\makeatletter
\newcommand{\notetocentryfont}{%
    \normalfont
    \fontsize{\dimexpr\f@size pt - 1pt\relax}{\dimexpr\baselineskip - 1pt\relax}\selectfont
}
\newcommand{\notetocentry}[5]{%
    \ifnum #1>\c@tocdepth \else
        \vskip -1.2pt
        {\leftskip #2\relax \rightskip \@tocrmarg \parfillskip -\rightskip
        \parindent #2\relax \@afterindenttrue \interlinepenalty\@M
        \leavevmode
        \@tempdima #3\relax
        \advance\leftskip \@tempdima \null\nobreak\hskip -\leftskip
        {\color{NoteTOCRed}\notetocentryfont #4}\nobreak
        \leaders\hbox{\textcolor{NoteTOCRed}{.\kern0.35em}}\hfill
        \nobreak\hb@xt@\@pnumwidth{\hfil\color{NoteTOCRed}\notetocentryfont #5}\par}%
    \fi
}

\@ifundefined{l@chapter}
{\def\l@chapter#1#2{\notetocentry{0}{0em}{2em}{#1}{#2}}}
{\renewcommand*\l@chapter[2]{\notetocentry{0}{0em}{2em}{#1}{#2}}}
\renewcommand*\l@section[2]{\notetocentry{1}{0em}{2em}{#1}{#2}}
\renewcommand*\l@subsection[2]{\notetocentry{2}{2em}{2.4em}{#1}{#2}}
\renewcommand*\l@subsubsection[2]{\notetocentry{3}{4em}{3em}{#1}{#2}}
\renewcommand*\l@figure[2]{\notetocentry{1}{0em}{2em}{#1}{#2}}
\renewcommand*\l@table[2]{\notetocentry{1}{0em}{2em}{#1}{#2}}
\renewcommand*\l@lstlisting[2]{\notetocentry{1}{0em}{2em}{#1}{#2}}

\newcommand{\notetocheading}[1]{%
    \par\noindent{\bfseries\fontsize{24}{28}\selectfont #1\par}%
}

\newcommand{\notetoclistheading}[1]{%
    \par\noindent{\bfseries\fontsize{14}{18}\selectfont #1\par}%
}
\newif\ifnote@toclof
\newif\ifnote@toclot
\newif\ifnote@toclol
\newcommand{\note@tocresetflags}{%
    \note@tocloffalse
    \note@toclotfalse
    \note@toclolfalse
}
\newcommand{\note@tocparseoptions}[1]{%
    \note@tocresetflags
    \def\note@tocraw{#1}%
    \ifx\note@tocraw\@empty\else
        \@for\note@tocoption:=#1\do{%
            \edef\note@tocoption{\expandafter\zap@space\note@tocoption \@empty}%
            \def\note@toclofkey{lof}%
            \def\note@toclotkey{lot}%
            \def\note@toclolkey{lol}%
            \ifx\note@tocoption\note@toclofkey
                \note@tocloftrue
            \fi
            \ifx\note@tocoption\note@toclotkey
                \note@toclottrue
            \fi
            \ifx\note@tocoption\note@toclolkey
                \note@tocloltrue
            \fi
        }%
    \fi
}

\makeatletter
\newcommand{\makecover}{%
    \hypersetup{pageanchor=false}%
    \begin{titlepage}
        \newgeometry{margin=1.25in}
        \parindent=0pt
        \thispagestyle{empty}
        \vspace*{0.22\textheight}
        \begin{flushright}
            {\bfseries\fontsize{28}{34}\selectfont \@title\par}
            \vspace{1.25em}
            {\Large\itshape \notecoversubtitle\par}
            \vspace{2.5em}
            {\large Last updated: \notecoverlastupdated\par}
        \end{flushright}
        \vfill
    \end{titlepage}
    \clearpage
    \hypersetup{pageanchor=true}%
    \restoregeometry
}

\newcommand{\makenotecontents}[1][]{%
    \clearpage
    \note@tocparseoptions{#1}%
    \notetocheading{Contents}%
    \vspace{\baselineskip}%
    \@starttoc{toc}%
    \ifnote@toclof
        \vspace{4pt}
        \notetoclistheading{List of Figures}%
        \@starttoc{lof}%
    \fi
    \ifnote@toclot
        \vspace{4pt}
        \notetoclistheading{List of Tables}%
        \@starttoc{lot}%
    \fi
    \ifnote@toclol
        \vspace{4pt}
        \notetoclistheading{List of Listings}%
        \@starttoc{lol}%
    \fi
    \ifnote@toclof
        \begin{center}
            \vspace{1em}
            \bfseries * \quad * \quad *
        \end{center}
    \else\ifnote@toclot
            \begin{center}
                \vspace{1em}
                \bfseries * \quad * \quad *
            \end{center}
        \else\ifnote@toclol
                \begin{center}
                    \vspace{1em}
                    \bfseries * \quad * \quad *
                \end{center}
            \fi\fi\fi
    \vspace{2em}%
    \clearpage
}
\makeatother

